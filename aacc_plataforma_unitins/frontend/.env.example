# .env.example — Frontend (Vite)
#
# Copie este arquivo para .env.local e preencha os valores.
# O arquivo .env.local NÃO deve ser versionado (já consta no .gitignore).
#
# -------------------------------------------------------------------
# URL base da API Django (sem barra final, sem /api no final)
# Exemplos:
#   Desenvolvimento local : http://localhost:8000/api
#   Produção (Render)     : https://seu-backend.onrender.com/api
# -------------------------------------------------------------------
VITE_API_URL=http://localhost:8000/api
